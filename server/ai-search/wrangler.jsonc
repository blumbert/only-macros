{
  // The Only Macros AI food search Worker. Deploy from this folder with
  // `npx wrangler deploy`. Secrets are set separately and never live here:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  //   npx wrangler secret put REVENUECAT_SECRET_KEY
  "name": "only-macros-ai-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "kv_namespaces": [
    // Monthly search counts and a short entitlement cache.
    { "binding": "USAGE", "id": "1ff0071c780240b684ed14838e96a8e5" }
  ],
  "observability": { "enabled": false }
}
