{
  // The Only Macros AI food search Worker. Deploy from this folder with
  // `npx wrangler deploy`. Secrets are set separately and never live here:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  //   npx wrangler secret put REVENUECAT_SECRET_KEY
  "name": "only-macros-ai-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "kv_namespaces": [
    // Monthly search counts and a short entitlement cache. The id is filled in
    // from `npx wrangler kv namespace create USAGE`.
    { "binding": "USAGE", "id": "REPLACE_WITH_KV_ID" }
  ],
  "observability": { "enabled": false }
}
